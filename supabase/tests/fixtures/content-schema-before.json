  "function_definition": "CREATE OR REPLACE FUNCTION public.decrement_portfolio_order_after(deleted_order integer)\n RETURNS void\n LANGUAGE plpgsql\nAS $function$\r\nBEGIN\r\n  UPDATE photos\r\n  SET portfolio_order = portfolio_order - 1\r\n  WHERE portfolio_order > deleted_order;\r\nEND;\r\n$function$\n",
